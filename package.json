{
  "name": "trusttrace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch api/server.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "start:api": "tsx api/server.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "tsx --test api/domain/product.test.ts api/lib/traceability.test.ts",
    "test:auth": "tsx --test api/routes/auth.integration.test.ts",
    "test:organizations": "tsx --test api/routes/organizations.integration.test.ts",
    "test:products": "tsx --test api/routes/products.integration.test.ts",
    "test:mvp": "tsx --test api/routes/mvp.integration.test.ts",
    "test:blockchain": "tsx --test api/routes/blockchain.integration.test.ts",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test solidity",
    "blockchain:node": "hardhat node --hostname 127.0.0.1",
    "blockchain:deploy": "tsx scripts/deploy-registry.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "ethers": "^6.17.0",
    "hardhat": "^3.18.0",
    "oxlint": "^1.81.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
